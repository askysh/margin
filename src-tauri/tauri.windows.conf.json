{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin Notes",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Margin Notes",
        "width": 1180,
        "height": 760,
        "minWidth": 440,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Askysh",
    "externalBin": null,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
