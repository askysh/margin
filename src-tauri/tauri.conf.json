{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin",
  "version": "0.0.10",
  "identifier": "com.akashmishra.margin",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Margin",
        "width": 1180,
        "height": 760,
        "minWidth": 440,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.productivity",
    "externalBin": [
      "binaries/margin-speech"
    ],
    "shortDescription": "Local-first meeting notes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1OUY0MUQ3QzIzNzM5MDMKUldRRE9UZkMxMEdmMVdFS3NZdlpBRWZIcE9VQ2s0SXFnNGIwRFVCdE9oNzhQMnErUThPbzJsTW0K",
      "endpoints": [
        "https://github.com/askysh/margin/releases/latest/download/latest.json"
      ]
    }
  }
}
