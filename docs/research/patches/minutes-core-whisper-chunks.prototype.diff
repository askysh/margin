+// ---- PROTOTYPE helpers (Margin research, not upstream code) ----
+#[cfg(feature = "whisper")]
+thread_local! {
+    static REUSED_STATE: std::cell::RefCell<Option<whisper_rs::WhisperState>> = const { std::cell::RefCell::new(None) };
+    static REUSE_ENABLED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Puts the state back for the next chunk when reuse is on; drops it otherwise.
+#[cfg(feature = "whisper")]
+struct ReturnState(Option<whisper_rs::WhisperState>);
+#[cfg(feature = "whisper")]
+impl Drop for ReturnState {
+    fn drop(&mut self) {
+        if REUSE_ENABLED.with(|c| c.get()) {
+            if let Some(state) = self.0.take() {
+                REUSED_STATE.with(|c| *c.borrow_mut() = Some(state));
+            }
+        }
+    }
+}
+
+#[cfg(feature = "whisper")]
+struct ReusedStateGuard;
+#[cfg(feature = "whisper")]
+impl ReusedStateGuard {
+    fn install(ctx: &whisper_rs::WhisperContext) -> Option<Self> {
+        if !std::env::var_os("MINUTES_PROTO_REUSE_STATE").is_some_and(|v| v == "1") {
+            return None;
+        }
+        let state = ctx.create_state().ok()?;
+        REUSED_STATE.with(|c| *c.borrow_mut() = Some(state));
+        REUSE_ENABLED.with(|c| c.set(true));
+        Some(Self)
+    }
+}
+#[cfg(feature = "whisper")]
+impl Drop for ReusedStateGuard {
+    fn drop(&mut self) {
+        REUSE_ENABLED.with(|c| c.set(false));
+        REUSED_STATE.with(|c| *c.borrow_mut() = None);
+    }
+}
+
+/// `MINUTES_PROTO_PACK_SECS` (0 = off): the longest window, silence included.
+fn pack_window_samples() -> usize {
+    std::env::var("MINUTES_PROTO_PACK_SECS")
+        .ok()
+        .and_then(|v| v.parse::<f64>().ok())
+        .map(|secs| (secs * 16000.0) as usize)
+        .unwrap_or(0)
+}
+
+/// Merge neighbouring chunks while the merged span (the silence between them
+/// included, so the timeline is unchanged) stays within `window` samples.
+fn pack_chunk_ranges(ranges: &[(usize, usize)], window: usize) -> Vec<(usize, usize)> {
+    if window == 0 {
+        return ranges.to_vec();
+    }
+    let mut out: Vec<(usize, usize)> = Vec::new();
+    for &(start, end) in ranges {
+        match out.last_mut() {
+            Some(last) if end - last.0 <= window => last.1 = end,
+            _ => out.push((start, end)),
+        }
+    }
+    out
+}
